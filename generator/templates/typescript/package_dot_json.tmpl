{
  "name": "@perata-sh/sdk",
  "version": "{{.Version}}",
  "description": "Peráta's SDK for TypeScript and JavaScript: products, customers, checkouts, payments, subscriptions and webhooks.",
  "license": "MIT",
  "homepage": "https://perata.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perata-sh/sdk.git",
    "directory": "typescript"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
