[package]
name = "perata"
version = "{{.Version}}"
edition = "2021"
rust-version = "1.88"
description = "Peráta's SDK for Rust: products, customers, checkouts, payments, subscriptions and webhooks."
license = "MIT"
homepage = "https://perata.sh"
repository = "https://github.com/perata-sh/sdk"
documentation = "https://docs.rs/perata"
readme = "README.md"
keywords = ["perata", "payments", "pix", "api", "webhooks"]
categories = ["api-bindings", "web-programming::http-client"]

[dependencies]
base64 = "0.23"
hmac = "0.13"
serde = { version = "1.0.200", features = ["derive"] }
serde_json = "1.0.100"
sha2 = "0.11"
ureq = { version = "3", default-features = false, features = ["rustls"] }
