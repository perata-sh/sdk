<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net8.0 and net10.0 are the LTS releases: System.Text.Json, HMACSHA256 and
    IAsyncEnumerable are in the box there, so the package depends on nothing.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Perata</RootNamespace>
    <AssemblyName>Perata</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>PerataSh.Sdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>Peráta</Authors>
    <Company>Peráta</Company>
    <Description>Peráta's SDK for .NET: products, customers, checkouts, payments, subscriptions and webhooks.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://perata.sh</PackageProjectUrl>
    <RepositoryUrl>https://github.com/perata-sh/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>perata;payments;pix;boleto;checkout;subscriptions;webhooks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
