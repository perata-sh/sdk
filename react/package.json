{
  "name": "@perata-sh/react",
  "version": "0.5.0",
  "private": true,
  "description": "React components and hooks for Peráta's checkout: a provider, a payment component, a card field and a checkout button.",
  "license": "MIT",
  "homepage": "https://perata.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perata-sh/sdk.git",
    "directory": "react"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@perata-sh/js": "^0.5.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@perata-sh/js": "file:../js",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  }
}
